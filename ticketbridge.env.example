TB_PORT=8099
TB_KEY=change-me-long-random
TB_GLPI_URL=http://192.168.1.149/glpi
TB_GLPI_APP_TOKEN=
TB_GLPI_USER_TOKEN=
TB_GELF_HOST=127.0.0.1
TB_GELF_PORT=12206
# Публичный адрес Graylog для Source Link в IRIS
TB_GRAYLOG_URL=https://graylog.apps.monitoring.test
# Access token для API Graylog (canary, обогащение исходными сообщениями)
TB_GRAYLOG_TOKEN=
TB_IRIS_URL=https://iris.apps.monitoring.test
TB_IRIS_KEY=
# IRIS v2: /alerts/add (по умолчанию); IRIS v3: /api/v2/alerts
TB_IRIS_API_PATH=/api/v2/alerts
# Обогащение алертов IRIS активами из HostDeck (пустой токен — выкл.)
TB_HOSTDECK_URL=http://127.0.0.1:8080
TB_HOSTDECK_TOKEN=
TB_HOSTDECK_TTL=300
# Maintenance только для явно перечисленных availability definition_id.
# Пустое значение — хост из host/hr_agent_name/hr_ip/source события; непустое — fallback для silence.
# Пример содержит только вымышленные ID и hostname; security-правила сюда не добавлять.
TB_AVAILABILITY_RULES={"availability-problem-example":"","availability-silence-example":"server-01.example.test"}
# Корреляция IRIS по связке «правило + актив» и скоринговая эскалация
TB_IRIS_CORR=1
TB_SCORE_WINDOW=86400
TB_SCORE_THRESHOLD=100
TB_SCORE_HIGH=50
TB_SCORE_MEDIUM=20
TB_SCORE_LOW=5
TB_SCORE_MITRE_MULT=2
# Продолжение активного кейса и контроль повторов после его закрытия
TB_CASE_SUPPRESSION=86400
TB_CASE_REOPEN_MIN_WEIGHT=50
TB_CASE_EVIDENCE_INTERVAL=3600
# Необязательная JSON-карта весов по event_definition_id или префиксу названия
TB_RULE_WEIGHTS={}
# ZIP с доказательствами в Evidences при создании кейса
TB_EVIDENCE_PACK=1
TB_EVIDENCE_RAW_LIMIT=200
# Ручной DFIR-сбор Velociraptor → Evidence кейса IRIS
TB_VR_BINARY=/opt/velociraptor/velociraptor
TB_VR_API_CONFIG=/home/ticketbridge/velociraptor-collector.yaml
TB_VR_GUI_URL=https://velociraptor.example.test
TB_VR_CREATOR=ticketbridge-collector
TB_VR_TIMEOUT=300
